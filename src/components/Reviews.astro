---
import { reviews } from '../data/site';
---

<section class="bg-slate-50 py-20">
  <div class="section-shell">
    <div class="max-w-2xl">
      <p class="kicker">Bewertungen</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
        Verifizierte Google-Rezensionen
      </h2>
      <p class="mt-3 text-slate-600">Platzhalter für echte Kundenstimmen. Bitte durch verifizierte Zitate ersetzen.</p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        reviews.map((review) => (
          <article class="surface-card p-6">
            <p class="text-copper-400" aria-label={`${review.rating} von 5 Sternen`}>
              {'★'.repeat(review.rating)}
            </p>
            <blockquote class="mt-4 text-sm leading-relaxed text-slate-700">„{review.quote}“</blockquote>
            <p class="mt-5 text-sm font-semibold text-slate-950">{review.author}</p>
            <p class="text-xs uppercase tracking-wide text-slate-400">{review.source}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
