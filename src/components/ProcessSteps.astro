---
import ProcessGrid from './react/ProcessGrid';
import BlurText from './reactbits/BlurText/BlurText';

interface Props {
  tone?: 'white' | 'muted';
}

const { tone = 'white' } = Astro.props;
---

<section class:list={['py-20', tone === 'muted' ? 'bg-slate-50' : 'bg-white']}>
  <div class="section-shell">
    <div class="max-w-2xl">
      <p class="kicker">Ablauf</p>
      <BlurText
        client:visible
        as="h2"
        text="Fünf Schritte bis zur Auszahlung"
        className="mt-3 font-display text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl"
      />
      <p class="mt-3 text-slate-600">
        Klar, nachvollziehbar und ausschließlich vor Ort am Firmenstandort.
      </p>
    </div>

    <ProcessGrid client:visible />
  </div>
</section>
