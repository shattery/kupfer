---
import { mapsDirectionsUrl, mapsSearchUrl, site } from '../data/site';

interface Props {
  class?: string;
}

const { class: className = 'min-h-[28rem]' } = Astro.props;
---

<div class:list={['relative overflow-hidden rounded-3xl border border-slate-800 bg-slate-950', className]}>
  <div class="pointer-events-none absolute inset-0 bg-hero-grid bg-[size:36px_36px] opacity-50"></div>
  <div class="pointer-events-none absolute left-1/2 top-[28%] h-48 w-48 -translate-x-1/2 rounded-full bg-copper-500/25 blur-3xl"></div>
  <div class="relative flex h-full flex-col items-center justify-center px-6 py-14 text-center text-white">
    <span class="grid h-14 w-14 place-items-center rounded-full bg-copper-metal shadow-copper" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="h-7 w-7 fill-none stroke-white" stroke-width="1.8">
        <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"></path>
        <circle cx="12" cy="10" r="2.2"></circle>
      </svg>
    </span>
    <p class="mt-5 font-display text-xl font-semibold">{site.name}</p>
    <p class="mt-2 text-sm leading-relaxed text-slate-300">
      {site.street}<br />{site.city}
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href={mapsSearchUrl()} class="btn-copper" target="_blank" rel="noopener noreferrer">
        In Google Maps öffnen
      </a>
      <a href={mapsDirectionsUrl()} class="btn-ghost" target="_blank" rel="noopener noreferrer">
        Route planen
      </a>
    </div>
    <p class="mt-4 max-w-sm text-xs leading-relaxed text-slate-400">
      Die eingebettete Karte erscheint, sobald Straße und Ort in den Firmendaten hinterlegt sind.
      Route und Standort öffnen direkt in Google Maps.
    </p>
  </div>
</div>
