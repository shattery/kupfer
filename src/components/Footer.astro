---
import { mapsSearchUrl, navItems, site } from '../data/site';
---

<footer class="bg-slate-950 text-slate-300">
  <div class="section-shell grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="inline-flex items-center gap-2.5 text-white">
        <img src="/logo-mark.svg" alt="Cupravo" width="36" height="36" class="h-9 w-9 shrink-0" />
        <span aria-hidden="true" class="font-display text-lg font-semibold">{site.name}</span>
      </a>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-slate-400">
        Ankauf von Kupferkabeln ausschließlich vor Ort. Transparent geprüft, verwogen und ausgezahlt.
      </p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-copper-300">Standort</p>
      <p class="mt-3 text-sm">{site.street}</p>
      <p class="text-sm">{site.city}</p>
      <p class="mt-2 text-sm">{site.phone}</p>
      <p class="text-sm">{site.email}</p>
      <a href={mapsSearchUrl()} class="mt-3 inline-block text-sm text-copper-300 hover:text-copper-200">
        Karte öffnen
      </a>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-copper-300">Öffnungszeiten</p>
      <p class="mt-3 text-sm">Mo–Fr: {site.hoursWeekday}</p>
      <p class="text-sm">Sa: {site.hoursSaturday}</p>
      <p class="text-sm">So: {site.hoursSunday}</p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-copper-300">Navigation</p>
      <ul class="mt-3 space-y-2 text-sm">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="hover:text-white">{item.label}</a>
          </li>
        ))}
        <li><a href="/ueber-uns" class="hover:text-white">Über uns</a></li>
        <li><a href="/impressum" class="hover:text-white">Impressum</a></li>
        <li><a href="/datenschutz" class="hover:text-white">Datenschutz</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="section-shell flex flex-col gap-2 py-6 text-xs text-slate-500 sm:flex-row sm:justify-between">
      <p>Ankauf ausschließlich am Firmenstandort. Keine Annahme von Sendungen.</p>
      <p>© {new Date().getFullYear()} {site.legalEntity}</p>
    </div>
  </div>
</footer>
