---
import ShinyText from './reactbits/ShinyText/ShinyText';
import BlurText from './reactbits/BlurText/BlurText';

interface Props {
  eyebrow: string;
  title: string;
  text?: string;
}

const { eyebrow, title, text } = Astro.props;
---

<section class="relative overflow-hidden bg-slate-950 py-16 text-white">
  <div class="hero-wash pointer-events-none absolute inset-0 z-0" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 z-0 bg-hero-grid bg-[size:48px_48px] opacity-20"></div>
  <div class="pointer-events-none absolute inset-0 z-0 bg-gradient-to-r from-slate-950/75 via-slate-950/40 to-slate-950/25"></div>
  <div class="section-shell relative z-10">
    <p class="kicker">
      <ShinyText client:idle text={eyebrow} color="#e8c9a8" shineColor="#fffaf3" speed={3.2} />
    </p>
    <BlurText
      client:idle
      as="h1"
      text={title}
      className="mt-3 max-w-3xl font-display text-4xl font-semibold tracking-tight sm:text-5xl"
    />
    {text && <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-300">{text}</p>}
  </div>
</section>
