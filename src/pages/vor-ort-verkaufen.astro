---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import MapPanel from '../components/MapPanel.astro';
import { mapsDirectionsUrl, site } from '../data/site';
---

<Layout
  title={`Vor Ort verkaufen | ${site.name}`}
  description={`Kupferkabel Ankauf am Standort ${site.city}. Öffnungszeiten, Adresse und Routenplaner. Ausschließlich persönliche Abgabe.`}
  keywords="Kupferkabel Ankauf [ORT], Kupferkabel verkaufen, Kupferkabel Ankaufspreis"
>
  <PageHero
    eyebrow="Standort"
    title="Vor Ort verkaufen"
    text="Prüfung, Verwiegung und Auszahlung finden ausschließlich am Firmenstandort statt."
  />

  <section class="py-16">
    <div class="section-shell grid gap-10 lg:grid-cols-2">
      <div class="space-y-6">
        <article class="surface-card p-6">
          <h2 class="font-display text-xl font-semibold text-slate-950">Adresse</h2>
          <p class="mt-3 text-slate-700">
            {site.name}<br />
            {site.street}<br />
            {site.city}
          </p>
          <p class="mt-4 text-sm text-slate-600">Telefon: {site.phone}</p>
          <p class="text-sm text-slate-600">E-Mail: {site.email}</p>
          <a href={mapsDirectionsUrl()} class="btn-copper mt-6" target="_blank" rel="noopener noreferrer">Routenplaner</a>
        </article>
        <article class="surface-card p-6">
          <h2 class="font-display text-xl font-semibold text-slate-950">Öffnungszeiten</h2>
          <dl class="mt-4 space-y-2 text-sm">
            <div class="flex justify-between gap-4 border-b border-slate-100 py-2">
              <dt>Montag–Freitag</dt>
              <dd class="font-medium">{site.hoursWeekday}</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-slate-100 py-2">
              <dt>Samstag</dt>
              <dd class="font-medium">{site.hoursSaturday}</dd>
            </div>
            <div class="flex justify-between gap-4 py-2">
              <dt>Sonntag</dt>
              <dd class="font-medium">{site.hoursSunday}</dd>
            </div>
          </dl>
        </article>
        <p class="text-sm text-slate-500">
          Hinweis: Es findet kein Paketversand statt. Ware wird nur persönlich am Standort angenommen.
        </p>
      </div>
      <MapPanel class="h-full min-h-[28rem]" />
    </div>
  </section>
</Layout>
