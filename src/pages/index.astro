---
import Layout from '../layouts/Layout.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Reviews from '../components/Reviews.astro';
import MapPanel from '../components/MapPanel.astro';
import HeroAurora from '../components/react/HeroAurora';
import HeroHeadline from '../components/react/HeroHeadline';
import HeroCalculator from '../components/react/HeroCalculator';
import HeroCounters from '../components/react/HeroCounters';
import AdvantageCards from '../components/react/AdvantageCards';
import CableMarquee from '../components/react/CableMarquee';
import CopperCta from '../components/react/CopperCta';
import ShinyText from '../components/reactbits/ShinyText/ShinyText';
import BlurText from '../components/reactbits/BlurText/BlurText';
import FadeContent from '../components/reactbits/FadeContent/FadeContent';
import { mapsDirectionsUrl, site } from '../data/site';
---

<Layout
  title={`Kupferkabel verkaufen | ${site.name}`}
  description="Kupferkabel Ankauf vor Ort: Prüfung, Verwiegung und Sofort-Auszahlung am Firmenstandort. Unverbindliche Richtwerte und klarer Ablauf."
  keywords="Kupferkabel verkaufen, Kupferkabel Ankaufspreis, Kupferkabel Ankauf [ORT]"
>
  <section class="relative overflow-hidden bg-slate-950 text-white">
    <div class="hero-wash pointer-events-none absolute inset-0 z-0" aria-hidden="true"></div>
    <HeroAurora client:idle />
    <div class="pointer-events-none absolute inset-0 z-0 bg-hero-grid bg-[size:48px_48px] opacity-25"></div>
    <div class="pointer-events-none absolute inset-0 z-0 bg-gradient-to-r from-slate-950/80 via-slate-950/35 to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 z-[1] h-20 bg-gradient-to-b from-transparent to-white"></div>
    <div class="section-shell relative z-10 grid items-center gap-12 py-20 lg:grid-cols-[1.1fr_0.9fr] lg:py-28">
      <div>
        <p class="kicker">
          <ShinyText client:idle text="Kupferkabel Ankauf [ORT]" color="#e8c9a8" shineColor="#fffaf3" speed={3.2} />
        </p>
        <HeroHeadline client:idle />
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-300">
          Seriöser Ankauf von Kupferkabeln am Firmenstandort. Prüfung, Verwiegung und Auszahlung persönlich –
          ohne Paketversand.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <CopperCta client:idle href="/kabel-verkaufen" label="KABEL VERKAUFEN" />
          <a href="/ankaufspreise" class="btn-ghost">Ankaufspreise ansehen</a>
        </div>
        <HeroCounters client:visible />
      </div>
      <HeroCalculator client:idle class="min-w-0" />
    </div>
  </section>

  <CableMarquee client:visible />

  <section class="bg-white py-20">
    <div class="section-shell">
      <div class="max-w-2xl">
        <p class="kicker">Vorteile</p>
        <BlurText
          client:visible
          as="h2"
          text="Klarer Prozess statt Unsicherheit"
          className="mt-3 font-display text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl"
        />
      </div>
      <AdvantageCards client:visible />
    </div>
  </section>

  <ProcessSteps tone="muted" />
  <Reviews />

  <section class="bg-white py-20">
    <FadeContent client:visible className="section-shell grid items-center gap-10 lg:grid-cols-2" duration={420}>
      <div>
        <p class="kicker">Standort</p>
        <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          Vor Ort in {site.city}
        </h2>
        <p class="mt-3 text-slate-600">
          {site.street}<br />{site.city}<br />{site.phone}
        </p>
        <CopperCta
          client:visible
          className="mt-6"
          href={mapsDirectionsUrl()}
          label="Routenplaner öffnen"
          target="_blank"
          rel="noopener noreferrer"
        />
        <p class="mt-4 text-sm text-slate-500">Mo–Fr {site.hoursWeekday} · Sa {site.hoursSaturday} · So {site.hoursSunday}</p>
      </div>
      <MapPanel class="h-80" />
    </FadeContent>
  </section>
</Layout>
