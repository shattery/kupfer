---
import Layout from '../layouts/Layout.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Reviews from '../components/Reviews.astro';
import MapPanel from '../components/MapPanel.astro';
import PriceCalculator from '../components/react/PriceCalculator';
import HeroCounters from '../components/react/HeroCounters';
import { mapsDirectionsUrl, site } from '../data/site';
---

<Layout
  title={`Kupferkabel verkaufen | ${site.name}`}
  description="Kupferkabel Ankauf vor Ort: Prüfung, Verwiegung und Sofort-Auszahlung am Firmenstandort. Unverbindliche Richtwerte und klarer Ablauf."
  keywords="Kupferkabel verkaufen, Kupferkabel Ankaufspreis, Kupferkabel Ankauf [ORT]"
>
  <section class="relative overflow-hidden bg-slate-950 text-white">
    <div class="pointer-events-none absolute inset-0 bg-hero-grid bg-[size:48px_48px] opacity-40"></div>
    <div class="pointer-events-none absolute -right-24 top-10 h-80 w-80 rounded-full bg-copper-500/20 blur-3xl"></div>
    <div class="section-shell relative grid items-center gap-12 py-20 lg:grid-cols-[1.1fr_0.9fr] lg:py-28">
      <div>
        <p class="kicker text-copper-300">Kupferkabel Ankauf [ORT]</p>
        <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
          Kupferkabel ankaufen.<br />Transparent. Vor Ort.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-300">
          Seriöser Ankauf von Kupferkabeln am Firmenstandort. Prüfung, Verwiegung und Auszahlung persönlich –
          ohne Paketversand.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/kabel-verkaufen" class="btn-copper">KABEL VERKAUFEN</a>
          <a href="/ankaufspreise" class="btn-ghost">Ankaufspreise ansehen</a>
        </div>
        <HeroCounters client:visible />
      </div>
      <div class="rounded-3xl border border-white/10 bg-white/5 p-2 backdrop-blur">
        <PriceCalculator client:load />
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="section-shell">
      <div class="max-w-2xl">
        <p class="kicker">Vorteile</p>
        <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          Klarer Prozess statt Unsicherheit
        </h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <article class="surface-card p-6">
          <h3 class="font-display text-xl font-semibold text-slate-950">Nur persönlich vor Ort</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Alle Transaktionen finden am Firmenstandort statt. Keine Annahme von Sendungen.
          </p>
        </article>
        <article class="surface-card p-6">
          <h3 class="font-display text-xl font-semibold text-slate-950">Prüfung vor dem Preis</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Kabelart, Reinheit und Gewicht bestimmen das Angebot – nachvollziehbar und nach Verwiegung.
          </p>
        </article>
        <article class="surface-card p-6">
          <h3 class="font-display text-xl font-semibold text-slate-950">Sofort-Auszahlung</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Nach Annahme der Ware erfolgt die Auszahlung direkt vor Ort.
          </p>
        </article>
      </div>
    </div>
  </section>

  <ProcessSteps />
  <Reviews />

  <section class="bg-white py-20">
    <div class="section-shell grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="kicker">Standort</p>
        <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          Vor Ort in {site.city}
        </h2>
        <p class="mt-3 text-slate-600">
          {site.street}<br />{site.city}<br />{site.phone}
        </p>
        <a href={mapsDirectionsUrl()} class="btn-copper mt-6" target="_blank" rel="noopener noreferrer">Routenplaner öffnen</a>
        <p class="mt-4 text-sm text-slate-500">Mo–Fr {site.hoursWeekday} · Sa {site.hoursSaturday} · So {site.hoursSunday}</p>
      </div>
      <MapPanel class="h-80" />
    </div>
  </section>
</Layout>
