---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import PhotoUploadForm from '../components/react/PhotoUploadForm';
import Surface from '../components/react/Surface';
import { site, telHref } from '../data/site';
---

<Layout
  title={`Kontakt | ${site.name}`}
  description={`Kontakt zum Kupferkabel-Ankauf von ${site.name} in ${site.city}. Telefon, E-Mail und Foto-Anfrage für den Vor-Ort-Termin.`}
  keywords="Kupferkabel Ankauf [ORT], Kupferkabel verkaufen, Kupferkabel Ankaufspreis"
>
  <PageHero
    eyebrow="Kontakt"
    title="Direkt in Verbindung treten"
    text="Fragen zu Kabelarten, Terminen oder großen Mengen klären wir persönlich. Der Ankauf bleibt vor Ort."
  />

  <section class="py-16">
    <div class="section-shell grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <aside class="space-y-4">
        <Surface client:visible className="surface-card">
          <div class="p-6">
            <h2 class="font-display text-lg font-semibold text-slate-950">Kontaktdaten</h2>
            <p class="mt-3 text-sm text-slate-600">{site.street}<br />{site.city}</p>
            <a href={telHref()} class="mt-3 block text-sm font-medium text-copper-700">{site.phone}</a>
            <p class="text-sm text-slate-600">{site.email}</p>
          </div>
        </Surface>
        <Surface client:visible className="surface-card" delay={80}>
          <p class="p-6 text-sm text-slate-600">
            Für Foto-Einschätzungen nutzen Sie das Formular. Eine verbindliche Bewertung erfolgt erst nach Prüfung vor Ort.
          </p>
        </Surface>
      </aside>
      <PhotoUploadForm client:visible />
    </div>
  </section>
</Layout>
