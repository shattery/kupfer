---
import Layout from '../layouts/Layout.astro';
import CopperCta from '../components/react/CopperCta';
import GradientText from '../components/reactbits/GradientText/GradientText';
import { site } from '../data/site';
---

<Layout
  title={`Seite nicht gefunden | ${site.name}`}
  description="Die angeforderte Seite existiert nicht. Zurück zum Kupferkabel-Ankauf vor Ort."
>
  <section class="py-24">
    <div class="section-shell max-w-xl text-center">
      <GradientText
        client:idle
        className="mx-auto font-display text-7xl font-semibold"
        colors={['#9a5a28', '#e8b07a', '#d97736', '#fff7ee']}
        animationSpeed={6}
      >
        404
      </GradientText>
      <h1 class="mt-3 font-display text-4xl font-semibold text-slate-950">Seite nicht gefunden</h1>
      <p class="mt-3 text-slate-600">Die Adresse existiert nicht. Der Ankauf findet weiterhin ausschließlich vor Ort statt.</p>
      <CopperCta client:idle className="mt-8" href="/" label="Zur Startseite" />
    </div>
  </section>
</Layout>
