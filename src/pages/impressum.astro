---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---

<Layout
  title={`Impressum | ${site.name}`}
  description="Impressum und Anbieterkennzeichnung für den Kupferkabel-Ankauf vor Ort."
  robots="index, follow"
>
  <PageHero
    eyebrow="Rechtliches"
    title="Impressum"
    text="Angaben gemäß § 5 TMG / Anbieterkennzeichnung. Platzhalter in site.ts vor Go-Live ersetzen."
  />

  <section class="bg-white py-16">
    <div class="section-shell max-w-3xl space-y-10 text-slate-700">
      <div>
        <h2 class="font-display text-xl font-semibold text-slate-950">Anbieter</h2>
        <p class="mt-3 leading-relaxed">
          {site.legalEntity}<br />
          {site.street}<br />
          {site.city}
        </p>
      </div>

      <div>
        <h2 class="font-display text-xl font-semibold text-slate-950">Vertreten durch</h2>
        <p class="mt-3 leading-relaxed">{site.representative}</p>
      </div>

      <div>
        <h2 class="font-display text-xl font-semibold text-slate-950">Kontakt</h2>
        <p class="mt-3 leading-relaxed">
          Telefon: {site.phone}<br />
          E-Mail: <a class="text-copper-700 hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>

      <div>
        <h2 class="font-display text-xl font-semibold text-slate-950">Register / Gewerbe</h2>
        <p class="mt-3 leading-relaxed">{site.registerInfo}</p>
      </div>

      <div>
        <h2 class="font-display text-xl font-semibold text-slate-950">USt-IdNr.</h2>
        <p class="mt-3 leading-relaxed">{site.vatId}</p>
      </div>

      <div>
        <h2 class="font-display text-xl font-semibold text-slate-950">Hinweis Ankauf</h2>
        <p class="mt-3 leading-relaxed">
          Soweit gesetzlich nötig: Angaben zu Erlaubnis oder Anzeige nach GewO bzw. einschlägigen
          Ankaufsregelungen — mit Steuerberater oder Anwalt des Betreibers klären (branchenabhängig).
        </p>
      </div>

      <div>
        <h2 class="font-display text-xl font-semibold text-slate-950">Streitschlichtung</h2>
        <p class="mt-3 leading-relaxed">
          Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:
          <a
            class="text-copper-700 hover:underline"
            href="https://ec.europa.eu/consumers/odr"
            target="_blank"
            rel="noopener noreferrer"
            >https://ec.europa.eu/consumers/odr</a
          >.
        </p>
        <p class="mt-3 leading-relaxed">
          Wir sind nicht verpflichtet und nicht bereit, an Streitbeilegungsverfahren vor einer
          Verbraucherschlichtungsstelle teilzunehmen.
        </p>
      </div>
    </div>
  </section>
</Layout>
