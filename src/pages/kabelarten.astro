---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { cables, formatPrice } from '../data/cables';
import { site } from '../data/site';
---

<Layout
  title={`Kabelarten im Ankauf | ${site.name}`}
  description="Übersicht akzeptierter Kupferkabel: NYM-J, Erdkabel, Starkstrom, flexible Leitungen, Einzeladern, Industrie-, Daten- und Koaxialkabel."
  keywords="Kupferkabel verkaufen, Kupferkabel Ankaufspreis, Kupferkabel Ankauf [ORT]"
>
  <PageHero
    eyebrow="Material"
    title="Akzeptierte Kabelarten"
    text="Wir prüfen vor Ort, welche Charge vorliegt. Unklare Typen können Sie fotografieren oder direkt mitbringen."
  />

  <section class="py-16">
    <div class="section-shell grid gap-6 md:grid-cols-2">
      {
        cables.map((cable) => (
          <article class="surface-card p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="font-display text-xl font-semibold text-slate-950">{cable.name}</h2>
                <p class="mt-1 text-xs uppercase tracking-wide text-copper-600">{cable.standards}</p>
              </div>
              <span class="rounded-full bg-copper-50 px-3 py-1 text-xs font-semibold text-copper-800">
                {formatPrice(cable.pricePerKg)}
              </span>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-slate-600">{cable.description}</p>
            <p class="mt-3 text-sm text-slate-500">Einsatz: {cable.typicalUse}</p>
            <ul class="mt-4 space-y-1.5 text-sm text-slate-700">
              {cable.features.map((feature) => (
                <li class="flex gap-2">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-copper-500" />
                  {feature}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
