---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import AdminGate from '../components/react/AdminGate';
import { site } from '../data/site';
---

<Layout
  title={`Admin | ${site.name}`}
  description="Interner Bereich zur Pflege von Richtwerten und der Anfragen-Pipeline. Nur für den lokalen Testbetrieb."
  keywords="Kupferkabel Ankaufspreis, Kupferkabel verkaufen, Kupferkabel Ankauf [ORT]"
  robots="noindex, nofollow"
>
  <PageHero
    eyebrow="Intern"
    title="Preispflege und Anfragen"
    text="Leichtgewichtiger lokaler Admin. Nach PIN-Freigabe: Daten nur in diesem Browser (localStorage)."
  />

  <section class="py-16">
    <div class="section-shell">
      <AdminGate client:only="react" />
    </div>
  </section>
</Layout>
